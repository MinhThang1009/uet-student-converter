# EditorConfig — consistent coding styles across editors (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Add language-specific indentation sections during generation. Do not impose a
# global width across stacks with different formatter conventions.

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
