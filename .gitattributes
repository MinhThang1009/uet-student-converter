# Normalize line endings to LF (avoid CRLF when developing on Windows with CI).
* text=auto eol=lf
*.sh text eol=lf

# Binary files, leave untouched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary

# Exclude development and CI metadata from release archives.
/.github/**     export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/.editorconfig  export-ignore
